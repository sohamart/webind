# ==========================================
# WEBIND GROUP - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=5000

# Client Application URL
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or local URI)
# If omitted or unavailable, the system automatically falls back to an embedded in-memory MongoDB engine for zero-friction local development!
MONGODB_URI=mongodb://127.0.0.1:27017/webind_ecosystem

# Security & Authentication
JWT_SECRET=webind_ultra_secure_jwt_secret_token_key_2026_production
JWT_EXPIRES_IN=7d

# Default Super Admin Seed Credentials
ADMIN_DEFAULT_EMAIL=admin@webindgroup.com
ADMIN_DEFAULT_PASSWORD=WebindAdmin2026!

# Cloudinary Cloud Storage (Optional for production media; defaults to resilient local disk uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Environment
NODE_ENV=development
